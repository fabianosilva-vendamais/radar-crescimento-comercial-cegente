# =====================================================================
# Variáveis de ambiente — Radar de Crescimento Comercial (VendaMais + Cegente)
# Copie para .env.local (local) ou cadastre na Vercel (produção).
# NUNCA versione o arquivo .env.local com valores reais.
#
# IMPORTANTE: banco e deploy são TOTALMENTE separados do projeto Lopas.
# Crie um NOVO projeto no Supabase e um NOVO projeto na Vercel para este Radar.
# =====================================================================

# Supabase (públicas — o navegador precisa do prefixo NEXT_PUBLIC_)
# A chave publicável no formato novo começa com sb_publishable_...
# (também funciona a anon key legada). Cole o VALOR nesta variável.
NEXT_PUBLIC_SUPABASE_URL=https://snhjzkmbxbqvqdgpwzwy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Supabase (SECRETA — somente servidor; marque como "Sensitive" na Vercel)
# A chave secreta no formato novo começa com sb_secret_...
# (também funciona a service_role key legada). Cole o VALOR nesta variável.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# E-mail (SMTP do Gmail / Google Workspace) — somente servidor
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@vendamais.com.br
SMTP_PASS=senha-de-app-de-16-letras
EMAIL_FROM=VendaMais + Cegente <seu-email@vendamais.com.br>

# URL pública do site (para o link do relatório no e-mail): {REPORT_BASE_URL}/r/{codigo}
REPORT_BASE_URL=https://radar-crescimento-comercial-cegente.vercel.app
